# Telegram delivery for the contact form (app/api/contact/route.ts).
# Copy to .env.local and fill in. If unset, enquiries are only logged to the
# server console (demo mode).
#
# 1. In Telegram, message @BotFather → /newbot → copy the token.
# 2. Open a chat with your new bot and send it any message.
# 3. Get your chat id: https://api.telegram.org/bot<TOKEN>/getUpdates
#    → look for "chat":{"id":...}
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
